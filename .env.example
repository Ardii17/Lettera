# ---- Supabase (wajib) ----
# Dapatkan dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# HANYA dipakai di server (server action / route handler).
# JANGAN pernah diprefix NEXT_PUBLIC_ dan jangan diimpor dari client component.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Opsional ----
# Set "true" hanya jika provider Google sudah dikonfigurasi di Supabase Auth.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
