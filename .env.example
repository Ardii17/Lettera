# ---- Supabase (wajib) ----
# Dapatkan dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# HANYA dipakai di server (server action / route handler).
# JANGAN pernah diprefix NEXT_PUBLIC_ dan jangan diimpor dari client component.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://lettera.my.id

# ---- Midtrans Payment Gateway (Opsional / Dynamic QRIS) ----
# Dapatkan dari Midtrans Dashboard > Settings > Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxx
# Set "true" jika sudah beralih ke mode Production Midtrans
MIDTRANS_IS_PRODUCTION=false
